{
  "manifest_version": 3,
  "name": "CUNY Schedule to Calendar",
  "version": "1.0.0",
  "description": "Export your CUNY Schedule Builder classes to a .ics calendar file for Google Calendar, Apple Calendar, and Outlook.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://sb.cunyfirst.cuny.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sb.cunyfirst.cuny.edu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
